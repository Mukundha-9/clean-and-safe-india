rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Issue photos (before and after evidence)
    match /issues/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // Vendor certificates & proof
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
